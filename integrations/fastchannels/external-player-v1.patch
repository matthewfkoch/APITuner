+def prepare_player_channel(channel) -> dict:
+    """Prepare intent extras without invoking ADB or registering a device.
+
+    Shared by the legacy bridge and external controllers. Keep manifest and
+    license preparation paired, including provider-specific playback settings.
+    """
+    from urllib.parse import quote, urljoin, urlsplit
+    from flask import request
+    from .routes.api_playback import _get_playback_info
+
+    info = _get_playback_info(channel, fast_mode=False)
+    manifest = info.get('preview_url') or info.get('play_url') or ''
+    license_url = info.get('license_url') or None
+    source = channel.source.name
+    if source == 'amazon_prime_free':
+        encoded_id = quote(channel.source_channel_id, safe='')
+        manifest = f'/play/amazon_prime_free/{encoded_id}/dash.mpd?hd=1'
+        license_url = f'/play/amazon_prime_free/license?channel_id={encoded_id}&hd=1'
+    if not manifest:
+        raise ValueError('No player manifest available')
+    if channel.requires_drm_bridge and not license_url:
+        raise ValueError('Protected channel has no license URL')
+    manifest = urljoin(request.host_url, manifest)
+    if any(part in urlsplit(manifest).path for part in
+           ('/play/fc-player/', '/play/auto/', '/play/prismcast/', '/play/tuner/')):
+        raise ValueError('Resolved URL points to a capture bridge')
+    result = dict(stream_url=manifest, title=channel.name or 'FastChannels',
+                  channel_key=f'{source}:{channel.source_channel_id}',
+                  drm=bool(license_url), captions=captions_enabled(), audio_mode=audio_mode())
+    if license_url:
+        result['license_url'] = urljoin(request.host_url, license_url)
+    return result
